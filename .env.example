# Web service
DEEPAUDIT_SERVER_PORT=8080
DEEPAUDIT_STORAGE_ROOT=./data

# PostgreSQL
DEEPAUDIT_DATASOURCE_URL=jdbc:postgresql://localhost:5432/deepaudit
DEEPAUDIT_DATASOURCE_USERNAME=deepaudit
DEEPAUDIT_DATASOURCE_PASSWORD=replace-with-your-database-password
DEEPAUDIT_DATASOURCE_DRIVER=org.postgresql.Driver

# Read-only Git ingestion
DEEPAUDIT_GIT_ALLOWED_HOSTS=github.com,gitlab.com,gitee.com
# Keep empty unless an explicitly trusted internal Git host only supports plaintext HTTP.
DEEPAUDIT_GIT_ALLOWED_HTTP_HOSTS=
DEEPAUDIT_GIT_ALLOW_LOCAL_REPOSITORIES=false
DEEPAUDIT_GIT_TIMEOUT_SECONDS=60
DEEPAUDIT_GIT_MAX_COMMITS=200
DEEPAUDIT_GIT_MAX_FILES=100000
DEEPAUDIT_GIT_MAX_FILE_BYTES=10485760
DEEPAUDIT_GIT_MAX_SNAPSHOT_BYTES=536870912

# Chat model
DEEPAUDIT_AI_BASE_URL=https://api.deepseek.com
DEEPAUDIT_AI_API_KEY=replace-with-your-api-key
DEEPAUDIT_AI_MODEL=deepseek-v4-flash

# CodeGraph is the required global topology provider in production.
DEEPAUDIT_CODEGRAPH_ENABLED=true
DEEPAUDIT_CODEGRAPH_EXECUTABLE=codegraph
DEEPAUDIT_CODEGRAPH_BUNDLE_ROOT=
DEEPAUDIT_CODEGRAPH_EXPECTED_VERSION=
DEEPAUDIT_CODEGRAPH_TIMEOUT_SECONDS=120
DEEPAUDIT_CODEGRAPH_MAX_OUTPUT_BYTES=8388608
DEEPAUDIT_CODEGRAPH_IMPACT_DEPTH=2
DEEPAUDIT_CODEGRAPH_RELATION_LIMIT=100
DEEPAUDIT_CODEGRAPH_AGENT_CONTEXT_LIMIT=10
DEEPAUDIT_CODEGRAPH_INDEX_DIRECTORY=.codegraph-deepaudit
